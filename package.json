{
  "name": "youdao",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --filter youdao-api dev",
    "dev:cf": "bun run --filter youdao-api dev:cf",
    "test": "bun run --filter youdao-api test",
    "typecheck": "bun run --filter youdao-api typecheck",
    "deploy": "bun run --filter youdao-api deploy",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4"
  }
}
