考","examInfo":{"year":5,"questionTypeInfo":[{"time":138,"type":"阅读"},{"time":9,"type":"短文填空"},{"time":33,"type":"听力"},{"time":0,"type":"翻译"},{"time":4,"type":"情景对话"},{"time":1,"type":"写作"},{"time":38,"type":"完形填空"},{"time":20,"type":"单项选择"},{"time":9,"type":"句子填空"}],"recommendationRate":4,"frequency":252},"return-phrase":"apple","pastExamSents":[{"en":"What would you like, ice cream or apple juice?","source":"2021·云南-云南省·单项选择","zh":"你想要什么，冰淇淋还是苹果汁？"},{"en":"After more than 30 years of development, the company has now beaten Apple and become the world's second largest maker of smartphones.","source":"2021·四川-达州·阅读","zh":"经过30多年的发展，该公司现已击败苹果，成为全球第二大智能手机制造商。"},{"en":"At the same time, sales from both Samsung and Apple fell.","source":"2021·四川-达州·阅读","zh":"与此同时，三星和苹果的销量都下降了。"},{"en":"The apple is one kind of recommended fruit during Frost's Descent.","source":"2021·湖南-衡阳·阅读","zh":"霜降期间，苹果是一种值得推荐的水果。"},{"en":"Though Apple stopped selling the Newton in 1998, the first iPhone wasn't available until 2007.","source":"2021·江西·阅读","zh":"虽然苹果公司在1998年就停止了牛顿手机的销售，但它直到2007年才推出第一代 iPhone。"},{"en":"The old woman begged, \"Then how about one dollar? So I can buy a small apple pie.\"","source":"2021·广西-柳州·阅读","zh":"老妇人恳求道：“那一美元怎么样？这样我就可以买一个小苹果派了。”"},{"en":"While Ben was working in the sun, Tom sat under a tree eating the apple and thinking how to catch more boys.","source":"2021·山东-临沂·阅读","zh":"当本在太阳下工作时，汤姆坐在树下吃苹果，想着如何吸引更多的男孩。"},{"en":"It took a lot of research and hard work to go from the Apple Newton to iPhone but in the end, the effort became successful.","source":"2021·江西·阅读","zh":"从苹果牛顿到 iPhone，苹果公司付出了大量的研究和努力，但最终努力换来了成功。"},{"en":"When Wang Jie described Li's red apple as being green, Li realized that Wang Jie must have run a red light.","source":"2021·内蒙古-赤峰·阅读","zh":"当王杰说李警官的红苹果是绿色的时，李警官意识到王杰一定是闯红灯了。"},{"en":"It is good to eat an apple every day.","source":"2021·广西-桂林·单项选择","zh":"每天吃一个苹果是好的。"},{"en":"In the early 1990s, Apple created a phone called the Apple Newton.","source":"2021·江西·阅读","zh":"20世纪90年代初，苹果公司制造了一款名为苹果牛顿的手机。"},{"en":"We had lots of pear trees and some apple trees.","source":"2021·辽宁-沈阳·短文填空","zh":"我们有很多梨树和一些苹果树。"},{"en":"Before going back to work one afternoon, Policeman Li took a big bite out of the red apple on his desk.","source":"2021·内蒙古-赤峰·阅读","zh":"一天下午，在回去上班之前，李警官咬了一大口桌上的红苹果。"},{"en":"The story of the Apple Newton can teach us an important lesson about failure.","source":"2021·江西·阅读","zh":"苹果牛顿的故事告诉我们一个与失败有关的重要道理。"},{"en":"That green apple on your desk looks delicious! I hope you enjoy it!","source":"2021·内蒙古-赤峰·阅读","zh":"你桌子上的那个绿苹果看起来很好吃！希望你吃得开心！"},{"en":"Digital technology at the apple storage helps to group apples, which can keep the stability in the quality.","source":"2021·江苏-南通·阅读","zh":"苹果储存处的数字技术有助于对苹果进行分组，保持质量的稳定性。"},{"en":"An apple a day keeps the doctor away.","source":"2018，2021·甘肃-武威，浙江-杭州·句子填空","zh":"一天一苹果，医生远离我。"},{"en":"Just then, Ben Rogers comes along the road with an apple in his hand.","source":"2020·山东-潍坊·短文填空","zh":"就在那时，本·罗杰斯沿着这条路走来，手里拿着一个苹果。"},{"en":"He said he got a strong feeling of satisfaction when he saw a lot of apples on the beautiful trees.","source":"2020·湖北-黄石·完形填空","zh":"他说，当他看到美丽的树上结满了苹果时，他有一种强烈的满足感。"},{"en":"One day he sent four of his students to go to a small farm to see apple trees in different seasons.","source":"2020·湖北-黄石·完形填空","zh":"一天，他派四个学生到一个小农场，观察不同季节的苹果树。"}]},"collins_primary":{"words":{"indexforms":["apple","apples","apples'","apple's"],"word":"apple"},"gramcat":[{"audiourl":"https://ydlunacommon-cdn.nosdn.127.net/714c33d45b182a51434ba094587c0db9.mp3","pronunciation":"ˈæpəl","senses":[{"examples":[{"sense":{"lang":"ZH-CN","word":"我打包午餐时总是放上一个苹果。"},"example":"I always have an apple in my packed lunch."}],"definition":"a firm round fruit with green, red or yellow skin","lang":"ZH-CN","word":"苹果"}],"partofspeech":"noun","audio":"02214","forms":[{"form":"apples"}]}]},"auth_sents_part":{"sentence-count":6,"more":"auth_sents","sent":[{"score":0.9831292629241943,"speech":"